#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Slave dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `slave` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-slave-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `slave pm
# install` and `slave update` keep that check.
# ============================================================================
_SLAVE_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_slave_test_env="--test-environment"
_slave_expect_extras=""
for _slave_arg in "$@"; do
    if [ -n "$_slave_expect_extras" ]; then
        _slave_test_env="--test-environment=$_slave_arg"
        _slave_expect_extras=""
        continue
    fi
    case "$_slave_arg" in
        --) break ;;
        --test-extras) _slave_expect_extras=1 ;;
        --test-extras=*) _slave_test_env="--test-environment=${_slave_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_slave_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _slave_arg _slave_test_env _slave_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _slave_arg _slave_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_SLAVE_REPO/scripts/_activation.sh"

if ! slave_sync "$_SLAVE_REPO" "$_slave_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _slave_test_env
    return 1 2>/dev/null || exit 1
fi
unset _slave_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __SLAVE_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_slave_script="$(slave_compose_env "$_SLAVE_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _slave_script
    return 1 2>/dev/null || exit 1
}
_slave_keys="$(printf '%s\n' "$_slave_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __SLAVE_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__SLAVE_SAVED_PATH="$PATH"
for _slave_k in $_slave_keys; do
    eval "__SLAVE_SAVED_$_slave_k=\"\${$_slave_k+set}\""
    eval "__SLAVE_PRIOR_$_slave_k=\${$_slave_k-__SLAVE_UNSET__}"
done
slave_apply_env "$_slave_script"

# This checkout, not whichever `slave` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__SLAVE_WORKTREE="$_SLAVE_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__SLAVE_WORKTREE_NAME="$(git -C "$_SLAVE_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__SLAVE_WORKTREE_NAME" ] || [ "$__SLAVE_WORKTREE_NAME" = HEAD ]; then
    __SLAVE_WORKTREE_NAME="$(basename "$_SLAVE_REPO")"
fi
__SLAVE_SAVED_PS1="${PS1-__SLAVE_UNSET__}"
__SLAVE_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__SLAVE_UNSET__}"

_slave_worktree_here() {
    _slave_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_slave_top" && pwd -P)" = "$(cd "$__SLAVE_WORKTREE" && pwd -P)" ]
}

slave() {
    _slave_worktree_here || {
        printf '%s\n' "slave: $(pwd) is outside $__SLAVE_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__SLAVE_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" slave "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe slave "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python slave "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe slave "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python slave "$@"
        else
            exec python slave "$@"
        fi
    )
}

_slave_prompt() {
    if [ "$__SLAVE_SAVED_PS1" = "__SLAVE_UNSET__" ]; then
        _slave_base_ps1=""
    else
        _slave_base_ps1="$__SLAVE_SAVED_PS1"
    fi
    if _slave_worktree_here; then
        PS1="($__SLAVE_WORKTREE_NAME) $_slave_base_ps1"
    else
        PS1="$_slave_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_slave_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_slave_prompt
fi
_slave_prompt

deactivate() {
    export PATH="$__SLAVE_SAVED_PATH"
    for _slave_k in $__SLAVE_KEY_LIST; do
        eval "_slave_was=\"\$__SLAVE_SAVED_$_slave_k\""
        eval "_slave_old=\"\$__SLAVE_PRIOR_$_slave_k\""
        if [ "$_slave_was" != "set" ]; then
            unset "$_slave_k"
        else
            export "$_slave_k=$_slave_old"
        fi
        unset "__SLAVE_SAVED_$_slave_k" "__SLAVE_PRIOR_$_slave_k"
    done
    if [ "$__SLAVE_SAVED_PS1" = "__SLAVE_UNSET__" ]; then
        unset PS1
    else
        PS1="$__SLAVE_SAVED_PS1"
    fi
    if [ "$__SLAVE_SAVED_PROMPT_COMMAND" = "__SLAVE_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__SLAVE_SAVED_PROMPT_COMMAND"
    fi
    unset __SLAVE_SAVED_PATH __SLAVE_KEY_LIST __SLAVE_ACTIVATED \
          __SLAVE_WORKTREE __SLAVE_WORKTREE_NAME \
          __SLAVE_SAVED_PS1 __SLAVE_SAVED_PROMPT_COMMAND
    unset -f deactivate slave _slave_worktree_here _slave_prompt
    unset _slave_k _slave_was _slave_old _slave_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__SLAVE_KEY_LIST="$_slave_keys"

# The composition library is not part of the user's shell.
unset -f slave_sync slave_bootstrap_python slave_compose_env slave_apply_env \
         slave_activation_current slave_ensure_env
unset _SLAVE_REPO _slave_script _slave_keys _slave_k _slave_top
